+package com.starrocks.authorization;
+
+import com.starrocks.qe.ConnectContext;
+import com.starrocks.sql.analyzer.Authorizer;
+import com.starrocks.sql.analyzer.AuthorizerStmtVisitor;
+import com.starrocks.sql.ast.ShowCreateExternalCatalogStmt;
+import com.starrocks.sql.parser.SqlParser;
+import com.starrocks.utframe.UtFrameUtils;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+import org.mockito.Mockito;
+
+/**
+ * SHOW CREATE CATALOG prints a catalog's properties, so it needs a privilege on that catalog. Before, any user
+ * who could log in read every catalog's endpoints and the ends of its credentials.
+ */
+public class ShowCreateCatalogPrivilegeTest {
+    private static ConnectContext connectContext;
+
+    @BeforeAll
+    public static void beforeClass() throws Exception {
+        UtFrameUtils.createMinStarRocksCluster();
+        connectContext = UtFrameUtils.createDefaultCtx();
+    }
+
+    private static ShowCreateExternalCatalogStmt parse(String catalog) {
+        return (ShowCreateExternalCatalogStmt) SqlParser.parse("SHOW CREATE CATALOG " + catalog,
+                connectContext.getSessionVariable()).get(0);
+    }
+
+    @Test
+    public void aUserWithNoPrivilegeOnTheCatalogIsRefused() {
+        try (MockedStatic<Authorizer> authorizer = Mockito.mockStatic(Authorizer.class, Mockito.CALLS_REAL_METHODS)) {
+            authorizer.when(() -> Authorizer.checkAnyActionOnCatalog(Mockito.any(), Mockito.eq("ice")))
+                    .thenThrow(new AccessDeniedException());
+
+            Exception e = Assertions.assertThrows(Exception.class,
+                    () -> new AuthorizerStmtVisitor().visit(parse("ice"), connectContext));
+
+            Assertions.assertTrue(e.getMessage().contains("Access denied"), e.getMessage());
+        }
+    }
+
+    @Test
+    public void aUserWithAPrivilegeOnTheCatalogPasses() {
+        try (MockedStatic<Authorizer> authorizer = Mockito.mockStatic(Authorizer.class, Mockito.CALLS_REAL_METHODS)) {
+            authorizer.when(() -> Authorizer.checkAnyActionOnCatalog(Mockito.any(), Mockito.eq("ice")))
+                    .thenAnswer(invocation -> null);
+
+            Assertions.assertDoesNotThrow(() -> new AuthorizerStmtVisitor().visit(parse("ice"), connectContext));
+            authorizer.verify(() -> Authorizer.checkAnyActionOnCatalog(Mockito.any(), Mockito.eq("ice")));
+        }
+    }
+
+    @Test
+    public void theInternalCatalogNeedsNoCheck() {
+        try (MockedStatic<Authorizer> authorizer = Mockito.mockStatic(Authorizer.class, Mockito.CALLS_REAL_METHODS)) {
+            Assertions.assertDoesNotThrow(
+                    () -> new AuthorizerStmtVisitor().visit(parse("default_catalog"), connectContext));
+            authorizer.verify(() -> Authorizer.checkAnyActionOnCatalog(Mockito.any(), Mockito.any()),
+                    Mockito.never());
+        }
+    }
+}
