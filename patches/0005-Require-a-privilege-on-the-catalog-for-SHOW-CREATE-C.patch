 import com.starrocks.sql.ast.ShowCreateTableStmt;
 import com.starrocks.sql.ast.ShowDataDistributionStmt;
 import com.starrocks.sql.ast.ShowDataStmt;
@@ -867,6 +868,25 @@ public class AuthorizerStmtVisitor implements AstVisitorExtendInterface<Void, Co
         return null;
     }
 
+    @Override
+    public Void visitShowCreateExternalCatalogStatement(ShowCreateExternalCatalogStmt statement,
+                                                        ConnectContext context) {
+        // The statement prints the catalog's properties (endpoints, warehouse, the first and last characters of
+        // its credentials), so it needs a privilege on the catalog, the same as SHOW CATALOGS listing it.
+        String catalogName = statement.getCatalogName();
+        if (CatalogMgr.isInternalCatalog(catalogName)) {
+            return null;
+        }
+        try {
+            Authorizer.checkAnyActionOnCatalog(context, catalogName);
+        } catch (AccessDeniedException e) {
+            AccessDeniedException.reportAccessDenied(catalogName,
+                    context.getCurrentUserIdentity(), context.getCurrentRoleIds(),
+                    PrivilegeType.ANY.name(), ObjectType.CATALOG.name(), catalogName);
+        }
+        return null;
+    }
+
     @Override
     public Void visitShowCatalogsStatement(ShowCatalogsStmt statement, ConnectContext context) {
         // `show catalogs` only show catalog that user has any privilege on, we will check it in
