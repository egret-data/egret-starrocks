+/**
+ * A metadata table (t$files, t$partitions, ...) exposes column bounds and partition values of its base table t,
+ * so reading it must need SELECT on t, and must be refused to a user whom a row access or masking policy on t
+ * applies to.
+ */
+public class ColumnPrivilegeMetadataTableTest {
+    private static final String CATALOG = InternalCatalog.DEFAULT_INTERNAL_CATALOG_NAME;
+
+    private StubAccessController controller;
+    private ConnectContext ctx;
+
+    /** An external access controller whose answers each test sets. */
+    private static class StubAccessController extends ExternalAccessController {
+        boolean allowSelect = true;
+        Expr rowAccessPolicy = null;
+        Map<String, Expr> maskingPolicy = null;
+        final List<TableName> selectChecked = new ArrayList<>();
+
+        @Override
+        public void checkTableAction(ConnectContext context, TableName tableName, PrivilegeType privilegeType)
+                throws AccessDeniedException {
+            selectChecked.add(tableName);
+            if (!allowSelect) {
+                throw new AccessDeniedException();
+            }
+        }
+
+        @Override
+        public void checkColumnAction(ConnectContext context, TableName tableName, String column,
+                                      PrivilegeType privilegeType) {
+        }
+
+        @Override
+        public Expr getRowAccessPolicy(ConnectContext context, TableName tableName) {
+            return rowAccessPolicy;
+        }
+
+        @Override
+        public Map<String, Expr> getColumnMaskingPolicy(ConnectContext context, TableName tableName,
+                                                        List<Column> columns) {
+            return maskingPolicy;
+        }
+    }
+
+    @BeforeAll
+    public static void beforeClass() throws Exception {
+        UtFrameUtils.createMinStarRocksCluster();
+        ConnectContext root = UtFrameUtils.createDefaultCtx();
+        new StarRocksAssert(root).withDatabase("db").useDatabase("db").withTable("CREATE TABLE `t1` (\n" +
+                "  `id` bigint NULL,\n" +
+                "  `email` varchar(64) NULL\n" +
+                ") ENGINE=OLAP\n" +
+                "DUPLICATE KEY(`id`)\n" +
+                "DISTRIBUTED BY HASH(`id`) BUCKETS 1\n" +
+                "PROPERTIES (\"replication_num\" = \"1\");");
+    }
+
+    @BeforeEach
+    public void setUp() {
+        controller = new StubAccessController();
+        Authorizer.getInstance().setAccessControl(CATALOG, controller);
+        ctx = new ConnectContext();
+        ctx.setCurrentUserIdentity(new UserIdentity("frank", "%"));
+        ctx.setDatabase("db");
+        ctx.setThreadLocalInfo();
+    }
+
+    @AfterEach
+    public void tearDown() {
+        Authorizer.getInstance().setAccessControl(CATALOG, new NativeAccessController());
+    }
+
+    private static MetadataTable metadataTableOfT1() {
+        return IcebergRefsTable.create(CATALOG, "db", "t1");
+    }
+
+    private static TableName metadataTableName() {
+        return new TableName(CATALOG, "db", "t1$refs");
+    }
+
+    private static ErrorCode errorCodeOf(Runnable check) {
+        ErrorReportException e = Assertions.assertThrows(ErrorReportException.class, check::run);
+        return e.getErrorCode();
+    }
+
+    @Test
+    public void testRefusedWithoutSelectOnBaseTable() {
+        controller.allowSelect = false;
+
+        ErrorCode code = errorCodeOf(() ->
+                ColumnPrivilege.checkMetadataTablePrivilege(ctx, metadataTableName(), metadataTableOfT1()));
+
+        Assertions.assertEquals(ErrorCode.ERR_ACCESS_DENIED_FOR_EXTERNAL_ACCESS_CONTROLLER, code);
+        Assertions.assertEquals(List.of(new TableName(CATALOG, "db", "t1")), controller.selectChecked,
+                "SELECT must be checked on the base table, not on the metadata table name");
+    }
+
+    @Test
+    public void testAllowedWithSelectAndNoPolicy() {
+        Assertions.assertDoesNotThrow(() ->
+                ColumnPrivilege.checkMetadataTablePrivilege(ctx, metadataTableName(), metadataTableOfT1()));
+        Assertions.assertEquals(1, controller.selectChecked.size());
+    }
+
+    @Test
+    public void testRefusedWhenRowAccessPolicyApplies() {
+        controller.rowAccessPolicy = new BoolLiteral(false);
+
+        ErrorCode code = errorCodeOf(() ->
+                ColumnPrivilege.checkMetadataTablePrivilege(ctx, metadataTableName(), metadataTableOfT1()));
+
+        Assertions.assertEquals(ErrorCode.ERR_ACCESS_DENIED_METADATA_TABLE_UNDER_POLICY, code);
+    }
+
+    @Test
+    public void testRefusedWhenColumnMaskingPolicyApplies() {
+        controller.maskingPolicy = Map.of("email", new NullLiteral());
+
+        ErrorCode code = errorCodeOf(() ->
+                ColumnPrivilege.checkMetadataTablePrivilege(ctx, metadataTableName(), metadataTableOfT1()));
+
+        Assertions.assertEquals(ErrorCode.ERR_ACCESS_DENIED_METADATA_TABLE_UNDER_POLICY, code);
+    }
+
+    @Test
+    public void testEmptyMaskingPolicyDoesNotRefuse() {
+        controller.maskingPolicy = Collections.emptyMap();
+
+        Assertions.assertDoesNotThrow(() ->
+                ColumnPrivilege.checkMetadataTablePrivilege(ctx, metadataTableName(), metadataTableOfT1()));
+    }
+
+    @Test
+    public void testMetadataCollectJobIsNotChecked() {
+        controller.allowSelect = false;
+        controller.rowAccessPolicy = new BoolLiteral(false);
+        ctx.setMetadataContext(true);
+
+        Assertions.assertDoesNotThrow(() ->
+                ColumnPrivilege.checkMetadataTablePrivilege(ctx, metadataTableName(), metadataTableOfT1()));
+        Assertions.assertTrue(controller.selectChecked.isEmpty());
+    }
+
+    /**
+     * Through {@link ColumnPrivilege#check}: before the fix a metadata table was skipped entirely, so this query
+     * passed for a user refused SELECT on the base table.
+     */
+    @Test
+    public void testCheckDoesNotSkipMetadataTable() throws Exception {
+        controller.allowSelect = false;
+        QueryStatement stmt = (QueryStatement) SqlParser.parse("select id from db.t1",
+                ctx.getSessionVariable().getSqlMode()).get(0);
+        Analyzer.analyze(stmt, ctx);
+        MetadataTable metadataTable = metadataTableOfT1();
+        new AstTraverser<Void, Void>() {
+            @Override
+            public Void visitTable(TableRelation node, Void context) {
+                node.setTable(metadataTable);
+                return null;
+            }
+        }.visit(stmt);
+
+        ErrorCode code = errorCodeOf(() -> ColumnPrivilege.check(ctx, stmt, Collections.emptyList()));
+
+        Assertions.assertEquals(ErrorCode.ERR_ACCESS_DENIED_FOR_EXTERNAL_ACCESS_CONTROLLER, code);
+        Assertions.assertTrue(controller.selectChecked.contains(new TableName(CATALOG, "db", "t1")));
+    }
+}
