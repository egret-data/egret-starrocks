+    /**
+     * A metadata table such as {@code t$files}, {@code t$entries}, {@code t$manifests} or {@code t$partitions}
+     * exposes data of its base table {@code t}: per-file row counts, per-column lower and upper bounds (actual
+     * column values) and partition values. Reading one therefore requires SELECT on {@code t} itself, checked at
+     * table level so that a user granted only some of t's columns does not read the bounds of the others.
+     *
+     * <p>It is also refused to a user whom a row access policy or a column masking policy on {@code t} applies
+     * to: neither policy can be applied to file-level statistics, so the metadata table would show such a user
+     * the bounds of masked columns and of the rows the filter removes.
+     */
+    public static void checkMetadataTablePrivilege(ConnectContext context, TableName tableName, MetadataTable table) {
+        // A metadata collect job (MetadataCollectJob) reads t$logical_iceberg_metadata as root on behalf of a
+        // query whose privileges on t were already checked. Root is still subject to row access and masking
+        // policies under an external access controller, so checking the job would refuse that query's planning.
+        if (context.isMetadataContext()) {
+            return;
+        }
+        String catalog = tableName.getCatalog() == null ? table.getCatalogName() : tableName.getCatalog();
+        String db = tableName.getDb() == null ? table.getOriginDb() : tableName.getDb();
+        TableName baseTableName = new TableName(catalog, db, table.getOriginTable());
+
+        try {
+            Authorizer.checkTableAction(context, baseTableName.getCatalog(), baseTableName.getDb(),
+                    baseTableName.getTbl(), PrivilegeType.SELECT);
+        } catch (AccessDeniedException e) {
+            AccessDeniedException.reportAccessDenied(
+                    baseTableName.getCatalog(),
+                    context.getCurrentUserIdentity(), context.getCurrentRoleIds(),
+                    PrivilegeType.SELECT.name(), ObjectType.TABLE.name(), baseTableName.getTbl());
+        }
+
+        if (isRestrictedByPolicy(context, baseTableName)) {
+            throw ErrorReportException.report(ErrorCode.ERR_ACCESS_DENIED_METADATA_TABLE_UNDER_POLICY,
+                    tableName.getTbl(), baseTableName.getTbl());
+        }
+    }
+
+    private static boolean isRestrictedByPolicy(ConnectContext context, TableName baseTableName) {
+        if (Authorizer.getRowAccessPolicy(context, baseTableName) != null) {
+            return true;
+        }
+        Table baseTable = GlobalStateMgr.getCurrentState().getMetadataMgr()
+                .getTable(context, baseTableName.getCatalog(), baseTableName.getDb(), baseTableName.getTbl());
+        if (baseTable == null) {
+            // Nothing to ask the masking policy about; creating the metadata table needed the base table anyway.
+            return false;
+        }
+        // The columns SecurityPolicyRewriteRule would mask on the base table.
+        List<Column> columns = baseTable.getBaseSchema().stream()
+                .filter(c -> !c.getType().isUnknown()).filter(Column::isVisible).toList();
+        Map<String, Expr> masking = Authorizer.getColumnMaskingPolicy(context, baseTableName, columns);
+        return masking != null && !masking.isEmpty();
+    }
