+package com.starrocks.authorization;
+
+import com.starrocks.catalog.TableName;
+import com.starrocks.common.ErrorCode;
+import com.starrocks.common.ErrorReportException;
+import com.starrocks.qe.ConnectContext;
+import com.starrocks.sql.analyzer.AnalyzerUtils;
+import com.starrocks.sql.ast.StatementBase;
+
+/**
+ * EXPLAIN COSTS prints the column statistics the optimizer holds for each table: minimum, maximum, null
+ * fraction and distinct count, collected over every row. A row access policy does not narrow them, so a user
+ * under one reads the range and cardinality of the rows it hides; a masked column's statistics are hidden
+ * already but its table's other columns are not. So EXPLAIN COSTS is refused when a row access or column
+ * masking policy applies to the user on any table the statement reads. The other EXPLAIN levels print no
+ * column statistics and stay allowed.
+ */
+public final class ExplainCostsPolicyCheck {
+    private ExplainCostsPolicyCheck() {
+    }
+
+    public static void check(StatementBase statement, ConnectContext context) {
+        if (!statement.isExplain() || statement.getExplainLevel() != StatementBase.ExplainLevel.COSTS) {
+            return;
+        }
+        if (context == null || context.getCurrentUserIdentity() == null) {
+            return;
+        }
+        for (TableName name : AnalyzerUtils.collectAllTable(statement).keySet()) {
+            TableName table = new TableName(
+                    name.getCatalog() == null ? context.getCurrentCatalog() : name.getCatalog(),
+                    name.getDb() == null ? context.getDatabase() : name.getDb(),
+                    name.getTbl());
+            if (ColumnPrivilege.isRestrictedByPolicy(context, table)) {
+                throw ErrorReportException.report(ErrorCode.ERR_ACCESS_DENIED_EXPLAIN_COSTS_UNDER_POLICY,
+                        table.toString());
+            }
+        }
+    }
+}
