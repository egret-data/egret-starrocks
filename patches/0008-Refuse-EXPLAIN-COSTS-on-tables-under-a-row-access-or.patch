+package com.starrocks.authorization;
+
+import com.starrocks.catalog.TableName;
+import com.starrocks.common.ErrorCode;
+import com.starrocks.common.ErrorReportException;
+import com.starrocks.qe.ConnectContext;
+import com.starrocks.sql.analyzer.Analyzer;
+import com.starrocks.sql.analyzer.Authorizer;
+import com.starrocks.sql.ast.StatementBase;
+import com.starrocks.sql.ast.expression.Expr;
+import com.starrocks.sql.parser.SqlParser;
+import com.starrocks.utframe.StarRocksAssert;
+import com.starrocks.utframe.UtFrameUtils;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+import org.mockito.Mockito;
+
+import java.util.Map;
+
+/**
+ * EXPLAIN COSTS prints the column statistics of the whole table, which a row access policy does not narrow, so
+ * it is refused when a row access or masking policy applies to the user on a table the statement reads.
+ */
+public class ExplainCostsPolicyCheckTest {
+    private static ConnectContext connectContext;
+
+    @BeforeAll
+    public static void beforeClass() throws Exception {
+        UtFrameUtils.createMinStarRocksCluster();
+        connectContext = UtFrameUtils.createDefaultCtx();
+        new StarRocksAssert(connectContext).withDatabase("db_ecp").useDatabase("db_ecp")
+                .withTable("CREATE TABLE customers (id BIGINT, phone VARCHAR(64)) DUPLICATE KEY(id) " +
+                        "DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES ('replication_num' = '1')")
+                .withTable("CREATE TABLE other (id BIGINT) DUPLICATE KEY(id) " +
+                        "DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES ('replication_num' = '1')")
+                .withView("CREATE VIEW v_customers AS SELECT id, phone FROM db_ecp.customers");
+    }
+
+    private static Expr expr(String sql) {
+        return SqlParser.parseSqlToExpr(sql, connectContext.getSessionVariable().getSqlMode());
+    }
+
+    /**
+     * Analyzes `sql` and runs the authorization check with a row filter or masks on db_ecp.customers only;
+     * returns what it threw, or null.
+     */
+    private static Throwable authorize(String sql, Expr rowFilter, Map<String, Expr> masks) {
+        try (MockedStatic<Authorizer> authorizer = Mockito.mockStatic(Authorizer.class, Mockito.CALLS_REAL_METHODS)) {
+            authorizer.when(() -> Authorizer.getRowAccessPolicy(Mockito.any(),
+                    Mockito.argThat((TableName t) -> t != null && "customers".equals(t.getTbl())))).thenReturn(rowFilter);
+            authorizer.when(() -> Authorizer.getColumnMaskingPolicy(Mockito.any(),
+                    Mockito.argThat((TableName t) -> t != null && "customers".equals(t.getTbl())), Mockito.any()))
+                    .thenReturn(masks);
+            StatementBase stmt = SqlParser.parse(sql, connectContext.getSessionVariable()).get(0);
+            try {
+                Analyzer.analyze(stmt, connectContext);
+                Authorizer.check(stmt, connectContext);
+                return null;
+            } catch (Throwable t) {
+                return t;
+            }
+        }
+    }
+
+    private static boolean refusedForPolicy(Throwable t) {
+        return t instanceof ErrorReportException e &&
+                e.getErrorCode() == ErrorCode.ERR_ACCESS_DENIED_EXPLAIN_COSTS_UNDER_POLICY;
+    }
+
+    @Test
+    public void aRowFilterRefusesExplainCosts() {
+        Throwable t = authorize("EXPLAIN COSTS SELECT id FROM db_ecp.customers", expr("id = 1"), Map.of());
+
+        Assertions.assertTrue(refusedForPolicy(t), String.valueOf(t));
+    }
+
+    @Test
+    public void aMaskRefusesExplainCosts() {
+        Throwable t = authorize("EXPLAIN COSTS SELECT id FROM db_ecp.customers", null, Map.of("phone", expr("NULL")));
+
+        Assertions.assertTrue(refusedForPolicy(t), String.valueOf(t));
+    }
+
+    @Test
+    public void aPolicyOnATableUnderAViewOrACteRefuses() {
+        Throwable view = authorize("EXPLAIN COSTS SELECT * FROM db_ecp.v_customers", expr("id = 1"), Map.of());
+        Throwable cte = authorize("EXPLAIN COSTS WITH x AS (SELECT id FROM db_ecp.customers) " +
+                "SELECT * FROM db_ecp.other JOIN x ON other.id = x.id", expr("id = 1"), Map.of());
+
+        Assertions.assertTrue(refusedForPolicy(view), String.valueOf(view));
+        Assertions.assertTrue(refusedForPolicy(cte), String.valueOf(cte));
+    }
+
+    @Test
+    public void theOtherExplainLevelsStayAllowed() {
+        for (String level : new String[] {"", "LOGICAL", "VERBOSE"}) {
+            Throwable t = authorize("EXPLAIN " + level + " SELECT id FROM db_ecp.customers", expr("id = 1"),
+                    Map.of("phone", expr("NULL")));
+
+            Assertions.assertNull(t, level);
+        }
+    }
+
+    @Test
+    public void explainCostsWithoutAPolicyStaysAllowed() {
+        Throwable none = authorize("EXPLAIN COSTS SELECT id FROM db_ecp.customers", null, Map.of());
+        Throwable other = authorize("EXPLAIN COSTS SELECT id FROM db_ecp.other", expr("id = 1"),
+                Map.of("phone", expr("NULL")));
+
+        Assertions.assertNull(none);
+        Assertions.assertNull(other);
+    }
+}
