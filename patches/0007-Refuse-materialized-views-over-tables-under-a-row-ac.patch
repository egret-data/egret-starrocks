+package com.starrocks.authorization;
+
+import com.starrocks.catalog.TableName;
+import com.starrocks.common.ErrorCode;
+import com.starrocks.common.ErrorReportException;
+import com.starrocks.qe.ConnectContext;
+
+/**
+ * A materialized view is filled by a refresh that reads its base tables without the row access and column
+ * masking policies of the user it runs as, and then serves the stored rows to whoever may read the view. So a
+ * user under such a policy on a base table must not create one over it, and a refresh must stop once its user
+ * comes under one: otherwise the user reads every row and column of the base table in the clear through the
+ * view.
+ */
+public final class MaterializedViewPolicyCheck {
+    private MaterializedViewPolicyCheck() {
+    }
+
+    public static void check(ConnectContext context, String mvName, TableName baseTable) {
+        if (context == null || context.getCurrentUserIdentity() == null) {
+            return;
+        }
+        if (ColumnPrivilege.isRestrictedByPolicy(context, baseTable)) {
+            throw ErrorReportException.report(ErrorCode.ERR_ACCESS_DENIED_MV_UNDER_POLICY, mvName,
+                    baseTable.toString(), context.getCurrentUserIdentity().toString());
+        }
+    }
+}
