+import com.starrocks.sql.parser.SqlParser;
+import com.starrocks.utframe.StarRocksAssert;
+import com.starrocks.utframe.UtFrameUtils;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+import org.mockito.Mockito;
+
+import java.util.Map;
+
+/**
+ * A materialized view stores its base tables' data without the row access and masking policies of its user, so
+ * a user under such a policy on a base table may not create one over it, and a refresh stops once its user is.
+ */
+public class MaterializedViewPolicyCheckTest {
+    private static final String CREATE_MV = "CREATE MATERIALIZED VIEW db_mvp.mv1 DISTRIBUTED BY HASH(id) " +
+            "REFRESH MANUAL PROPERTIES ('replication_num' = '1') AS SELECT id, phone FROM db_mvp.customers";
+    private static ConnectContext connectContext;
+
+    @BeforeAll
+    public static void beforeClass() throws Exception {
+        UtFrameUtils.createMinStarRocksCluster();
+        connectContext = UtFrameUtils.createDefaultCtx();
+        new StarRocksAssert(connectContext).withDatabase("db_mvp").useDatabase("db_mvp")
+                .withTable("CREATE TABLE customers (id BIGINT, phone VARCHAR(64)) DUPLICATE KEY(id) " +
+                        "DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES ('replication_num' = '1')")
+                .withTable("CREATE TABLE other (id BIGINT) DUPLICATE KEY(id) " +
+                        "DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES ('replication_num' = '1')");
+    }
+
+    private static Expr expr(String sql) {
+        return SqlParser.parseSqlToExpr(sql, connectContext.getSessionVariable().getSqlMode());
+    }
+
+    /** Analyzes `sql` with a row filter or masks on db_mvp.customers only; returns what it threw, or null. */
+    private static Throwable analyze(String sql, Expr rowFilter, Map<String, Expr> masks) {
+        try (MockedStatic<Authorizer> authorizer = Mockito.mockStatic(Authorizer.class, Mockito.CALLS_REAL_METHODS)) {
+            authorizer.when(() -> Authorizer.getRowAccessPolicy(Mockito.any(),
+                    Mockito.argThat((TableName t) -> t != null && "customers".equals(t.getTbl())))).thenReturn(rowFilter);
+            authorizer.when(() -> Authorizer.getColumnMaskingPolicy(Mockito.any(),
+                    Mockito.argThat((TableName t) -> t != null && "customers".equals(t.getTbl())), Mockito.any()))
+                    .thenReturn(masks);
+            StatementBase stmt = SqlParser.parse(sql, connectContext.getSessionVariable()).get(0);
+            try {
+                Analyzer.analyze(stmt, connectContext);
+                return null;
+            } catch (Throwable t) {
+                return t;
+            }
+        }
+    }
+
+    private static boolean refusedForPolicy(Throwable t) {
+        return t instanceof ErrorReportException e && e.getErrorCode() == ErrorCode.ERR_ACCESS_DENIED_MV_UNDER_POLICY;
+    }
+
+    @Test
+    public void aRowFilterOnABaseTableRefusesTheMaterializedView() {
+        Throwable t = analyze(CREATE_MV, expr("id = 1"), Map.of());
+
+        Assertions.assertTrue(refusedForPolicy(t), String.valueOf(t));
+    }
+
+    @Test
+    public void aMaskOnABaseTableRefusesTheMaterializedView() {
+        Throwable t = analyze(CREATE_MV, null, Map.of("phone", expr("NULL")));
+
+        Assertions.assertTrue(refusedForPolicy(t), String.valueOf(t));
+    }
+
+    @Test
+    public void aMaskOnAColumnTheViewDoesNotReadStillRefuses() {
+        // The policy is on the table for this user; which columns the view reads does not matter.
+        Throwable t = analyze(CREATE_MV.replace("SELECT id, phone", "SELECT id"), null,
+                Map.of("phone", expr("NULL")));
+
+        Assertions.assertTrue(refusedForPolicy(t), String.valueOf(t));
+    }
+
+    @Test
+    public void noPolicyOnTheBaseTablesLetsItThrough() {
+        Throwable t = analyze(CREATE_MV, null, Map.of());
+
+        Assertions.assertNull(t);
+    }
+
+    @Test
+    public void aPolicyOnAnotherTableDoesNotRefuse() {
+        Throwable t = analyze(CREATE_MV.replace("mv1", "mv2").replace("SELECT id, phone FROM db_mvp.customers",
+                "SELECT id FROM db_mvp.other"), expr("id = 1"), Map.of("phone", expr("NULL")));
+
+        Assertions.assertNull(t);
+    }
+
+    @Test
+    public void aRefreshChecksItsUserTheSameWay() {
+        TableName customers = new TableName("default_catalog", "db_mvp", "customers");
+        try (MockedStatic<Authorizer> authorizer = Mockito.mockStatic(Authorizer.class, Mockito.CALLS_REAL_METHODS)) {
+            authorizer.when(() -> Authorizer.getRowAccessPolicy(Mockito.any(), Mockito.any()))
+                    .thenReturn(expr("id = 1"));
+
+            Throwable t = Assertions.assertThrows(ErrorReportException.class,
+                    () -> MaterializedViewPolicyCheck.check(connectContext, "mv1", customers));
+
+            Assertions.assertTrue(refusedForPolicy(t));
+        }
+        Assertions.assertDoesNotThrow(() -> MaterializedViewPolicyCheck.check(connectContext, "mv1", customers));
+    }
+}
