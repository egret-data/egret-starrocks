-    private static boolean isRestrictedByPolicy(ConnectContext context, TableName baseTableName) {
+    /**
+     * Whether a row access policy, or a column masking policy on any of its columns, applies to this user on the
+     * table. A copy of the table's data (a metadata table's statistics, a materialized view) cannot carry either
+     * policy, so such a copy is refused to that user.
+     */
+    public static boolean isRestrictedByPolicy(ConnectContext context, TableName baseTableName) {
         if (Authorizer.getRowAccessPolicy(context, baseTableName) != null) {
             return true;
         }
