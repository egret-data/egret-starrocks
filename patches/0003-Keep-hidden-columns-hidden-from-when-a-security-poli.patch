+package com.starrocks.authorization;
+
+import com.starrocks.catalog.Column;
+import com.starrocks.catalog.Database;
+import com.starrocks.catalog.Table;
+import com.starrocks.qe.ConnectContext;
+import com.starrocks.server.GlobalStateMgr;
+import com.starrocks.sql.analyzer.Analyzer;
+import com.starrocks.sql.analyzer.Authorizer;
+import com.starrocks.sql.ast.AstTraverser;
+import com.starrocks.sql.ast.QueryStatement;
+import com.starrocks.sql.ast.Relation;
+import com.starrocks.sql.ast.SelectRelation;
+import com.starrocks.sql.ast.StatementBase;
+import com.starrocks.sql.ast.SubqueryRelation;
+import com.starrocks.sql.ast.expression.Expr;
+import com.starrocks.sql.parser.SqlParser;
+import com.starrocks.utframe.StarRocksAssert;
+import com.starrocks.utframe.UtFrameUtils;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+import org.mockito.Mockito;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * A hidden column (Iceberg's _file and _pos) stays out of `SELECT *` when a row access or column masking policy
+ * rewrites the table into a subquery, and can still be named. Before the fix the rewrite selected the hidden
+ * columns as ordinary ones, so only users under a policy got them in `SELECT *`.
+ */
+public class SecurityPolicyHiddenColumnTest {
+    private static ConnectContext connectContext;
+
+    @BeforeAll
+    public static void beforeClass() throws Exception {
+        UtFrameUtils.createMinStarRocksCluster();
+        connectContext = UtFrameUtils.createDefaultCtx();
+        StarRocksAssert starRocksAssert = new StarRocksAssert(connectContext);
+        starRocksAssert.withDatabase("db_hidden").useDatabase("db_hidden").withTable("CREATE TABLE `t_hidden` (\n" +
+                "  `v4` bigint NULL,\n" +
+                "  `v5` bigint NULL,\n" +
+                "  `v6` bigint NULL\n" +
+                ") ENGINE=OLAP\n" +
+                "DUPLICATE KEY(`v4`)\n" +
+                "DISTRIBUTED BY HASH(`v4`) BUCKETS 1\n" +
+                "PROPERTIES (\"replication_num\" = \"1\");");
+        Database db = GlobalStateMgr.getCurrentState().getLocalMetastore().getDb("db_hidden");
+        Table table = GlobalStateMgr.getCurrentState().getLocalMetastore().getTable(db.getFullName(), "t_hidden");
+        // Stands in for Iceberg's _file: in the base schema, but hidden.
+        Column v6 = table.getColumn("v6");
+        v6.setIsHidden(true);
+    }
+
+    private static QueryStatement analyzeUnderPolicy(String sql, Map<String, Expr> masks, Expr rowFilter) {
+        try (MockedStatic<Authorizer> authorizer = Mockito.mockStatic(Authorizer.class)) {
+            authorizer.when(() -> Authorizer.getColumnMaskingPolicy(Mockito.any(), Mockito.any(), Mockito.any()))
+                    .thenReturn(masks);
+            authorizer.when(() -> Authorizer.getRowAccessPolicy(Mockito.any(), Mockito.any())).thenReturn(rowFilter);
+            StatementBase stmt = SqlParser.parse(sql, connectContext.getSessionVariable().getSqlMode()).get(0);
+            new AstTraverser<Void, Void>() {
+                @Override
+                public Void visitRelation(Relation relation, Void context) {
+                    relation.setNeedRewrittenByPolicy(true);
+                    return null;
+                }
+            }.visit(stmt);
+            Analyzer.analyze(stmt, connectContext);
+            return (QueryStatement) stmt;
+        }
+    }
+
+    private static Expr expr(String sql) {
+        return SqlParser.parseSqlToExpr(sql, connectContext.getSessionVariable().getSqlMode());
+    }
+
+    private static boolean rewritten(QueryStatement stmt) {
+        return ((SelectRelation) stmt.getQueryRelation()).getRelation() instanceof SubqueryRelation;
+    }
+
+    @Test
+    public void starSkipsTheHiddenColumnWithoutAPolicy() {
+        QueryStatement stmt = analyzeUnderPolicy("select * from db_hidden.t_hidden", Map.of(), null);
+
+        Assertions.assertFalse(rewritten(stmt));
+        Assertions.assertEquals(List.of("v4", "v5"), stmt.getQueryRelation().getColumnOutputNames());
+    }
+
+    @Test
+    public void starSkipsTheHiddenColumnUnderARowFilter() {
+        QueryStatement stmt = analyzeUnderPolicy("select * from db_hidden.t_hidden", Map.of(), expr("v4 > 0"));
+
+        Assertions.assertTrue(rewritten(stmt));
+        Assertions.assertEquals(List.of("v4", "v5"), stmt.getQueryRelation().getColumnOutputNames());
+    }
+
+    @Test
+    public void starSkipsTheHiddenColumnUnderAMask() {
+        QueryStatement stmt = analyzeUnderPolicy("select * from db_hidden.t_hidden t", Map.of("v5", expr("v5 + 1")),
+                null);
+
+        Assertions.assertTrue(rewritten(stmt));
+        Assertions.assertEquals(List.of("v4", "v5"), stmt.getQueryRelation().getColumnOutputNames());
+    }
+
+    @Test
+    public void qualifiedStarSkipsTheHiddenColumnUnderARowFilter() {
+        QueryStatement stmt = analyzeUnderPolicy("select t.* from db_hidden.t_hidden t", Map.of(), expr("v4 > 0"));
+
+        Assertions.assertTrue(rewritten(stmt));
+        Assertions.assertEquals(List.of("v4", "v5"), stmt.getQueryRelation().getColumnOutputNames());
+    }
+
+    @Test
+    public void theHiddenColumnCanStillBeNamedUnderARowFilter() {
+        // An Iceberg DELETE reads `SELECT _file, _pos FROM t WHERE ...` through the same rewrite.
+        QueryStatement stmt = analyzeUnderPolicy("select v4, V6 from db_hidden.t_hidden", Map.of(), expr("v4 > 0"));
+
+        Assertions.assertTrue(rewritten(stmt));
+        Assertions.assertEquals(List.of("v4", "V6"), stmt.getQueryRelation().getColumnOutputNames());
+    }
+
+    @Test
+    public void theNamesOfTheHiddenColumnsComeFromTheTable() {
+        QueryStatement stmt = analyzeUnderPolicy("select * from db_hidden.t_hidden", Map.of(), expr("v4 > 0"));
+        SubqueryRelation subquery = (SubqueryRelation) ((SelectRelation) stmt.getQueryRelation()).getRelation();
+
+        Assertions.assertTrue(subquery.getHiddenColumnNames().contains("V6"));
+        Assertions.assertEquals(1, subquery.getHiddenColumnNames().size());
+    }
+}
