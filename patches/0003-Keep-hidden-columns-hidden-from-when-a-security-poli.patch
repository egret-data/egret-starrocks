From 7c627fa52a7c7fdcd5c26d4463f321e06db9d08c Mon Sep 17 00:00:00 2001
From: 1Pro-L4R8 <hoangquocvietbk2.13@gmail.com>
Date: Mon, 2 Nov 2026 19:14:11 +0700
Subject: [PATCH] Keep hidden columns hidden from * when a security policy
 rewrites a table

A row access or column masking policy rewrites the table into a subquery
that selects every column of the base schema by name, including hidden ones
(Iceberg's _file and _pos). The subquery's output fields were all visible,
so `SELECT *` returned the hidden columns only for users under a policy: a
different result shape per user, broken INSERT ... SELECT * and views over
`SELECT *` for those users.

The rewritten subquery now records the table's hidden column names and keeps
those output fields invisible, so `*` skips them as it does on the table,
while a statement can still name them (an Iceberg DELETE reads _file and
_pos through the same rewrite).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../SecurityPolicyRewriteRule.java            |  20 +++
 .../starrocks/sql/analyzer/QueryAnalyzer.java |   4 +-
 .../starrocks/sql/ast/SubqueryRelation.java   |  14 ++
 .../SecurityPolicyHiddenColumnTest.java       | 147 ++++++++++++++++++
 4 files changed, 184 insertions(+), 1 deletion(-)
 create mode 100644 fe/fe-core/src/test/java/com/starrocks/authorization/SecurityPolicyHiddenColumnTest.java

diff --git a/fe/fe-core/src/main/java/com/starrocks/authorization/SecurityPolicyRewriteRule.java b/fe/fe-core/src/main/java/com/starrocks/authorization/SecurityPolicyRewriteRule.java
index 7f39aa4acc6..909335f6ef8 100644
--- a/fe/fe-core/src/main/java/com/starrocks/authorization/SecurityPolicyRewriteRule.java
+++ b/fe/fe-core/src/main/java/com/starrocks/authorization/SecurityPolicyRewriteRule.java
@@ -34,6 +34,8 @@ import java.util.ArrayList;
 import java.util.Collections;
 import java.util.List;
 import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
 import java.util.stream.Collectors;
 
 public class SecurityPolicyRewriteRule {
@@ -90,4 +92,22 @@ public class SecurityPolicyRewriteRule {
         selectRelation.setOrderBy(Collections.emptyList());
         return new QueryStatement(selectRelation);
     }
+
+    /**
+     * The hidden columns of the relation {@link #buildView} rewrites. The view selects them by name so that a
+     * statement can still name them (an Iceberg DELETE reads _file and _pos), but `*` over the view must skip
+     * them as it skips them over the table; otherwise a user under a row access or masking policy gets extra
+     * columns in `SELECT *` that every other user does not.
+     */
+    public static Set<String> hiddenColumnNames(Relation relation) {
+        Set<String> names = new TreeSet<>(String.CASE_INSENSITIVE_ORDER);
+        if (relation instanceof TableRelation tableRelation) {
+            for (Column column : tableRelation.getTable().getBaseSchema()) {
+                if (column.isHidden()) {
+                    names.add(column.getName());
+                }
+            }
+        }
+        return names;
+    }
 }
diff --git a/fe/fe-core/src/main/java/com/starrocks/sql/analyzer/QueryAnalyzer.java b/fe/fe-core/src/main/java/com/starrocks/sql/analyzer/QueryAnalyzer.java
index 4ff1b65392a..adbea164e39 100644
--- a/fe/fe-core/src/main/java/com/starrocks/sql/analyzer/QueryAnalyzer.java
+++ b/fe/fe-core/src/main/java/com/starrocks/sql/analyzer/QueryAnalyzer.java
@@ -828,6 +828,7 @@ public class QueryAnalyzer {
                 } else {
                     r.setNeedRewrittenByPolicy(false);
                     SubqueryRelation subqueryRelation = new SubqueryRelation(policyRewriteQuery);
+                    subqueryRelation.setHiddenColumnNames(SecurityPolicyRewriteRule.hiddenColumnNames(r));
 
                     // If an alias exists, rewrite the alias into subquery to ensure
                     // that the original expression can be resolved correctly.
@@ -1467,8 +1468,9 @@ public class QueryAnalyzer {
                     fieldResolveName = field.getName();
                 }
 
+                boolean visible = !subquery.getHiddenColumnNames().contains(field.getName());
                 outputFields.add(new Field(fieldResolveName, field.getType(), subquery.getResolveTableName(),
-                        field.getOriginExpression()));
+                        field.getOriginExpression(), visible));
 
             }
             Scope scope = new Scope(RelationId.of(subquery), new RelationFields(outputFields.build()));
diff --git a/fe/fe-core/src/main/java/com/starrocks/sql/ast/SubqueryRelation.java b/fe/fe-core/src/main/java/com/starrocks/sql/ast/SubqueryRelation.java
index e9629fff7a9..2d34e79d169 100644
--- a/fe/fe-core/src/main/java/com/starrocks/sql/ast/SubqueryRelation.java
+++ b/fe/fe-core/src/main/java/com/starrocks/sql/ast/SubqueryRelation.java
@@ -18,14 +18,20 @@ import com.starrocks.sql.analyzer.FieldId;
 import com.starrocks.sql.ast.expression.Expr;
 import com.starrocks.sql.parser.NodePosition;
 
+import java.util.Collections;
 import java.util.List;
 import java.util.Map;
+import java.util.Set;
 
 public class SubqueryRelation extends QueryRelation {
     private final QueryStatement queryStatement;
 
     private final boolean assertRows;
 
+    // Output columns that stay hidden from `*`, as they are in the relation this subquery replaces: the
+    // hidden columns of a table that a security policy rewrote into a subquery (Iceberg's _file and _pos).
+    private Set<String> hiddenColumnNames = Collections.emptySet();
+
     public SubqueryRelation(QueryStatement queryStatement) {
         this(queryStatement, false, queryStatement.getPos());
     }
@@ -45,6 +51,14 @@ public class SubqueryRelation extends QueryRelation {
         return assertRows;
     }
 
+    public Set<String> getHiddenColumnNames() {
+        return hiddenColumnNames;
+    }
+
+    public void setHiddenColumnNames(Set<String> hiddenColumnNames) {
+        this.hiddenColumnNames = hiddenColumnNames;
+    }
+
     @Override
     public Map<Expr, FieldId> getColumnReferences() {
         return queryStatement.getQueryRelation().getColumnReferences();
