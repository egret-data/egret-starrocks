+package com.starrocks.authorization;
+
+import com.starrocks.qe.SessionVariable;
+import com.starrocks.sql.ast.AstTraverser;
+import com.starrocks.sql.ast.Relation;
+import com.starrocks.sql.ast.StatementBase;
+import com.starrocks.sql.ast.TableRelation;
+import com.starrocks.sql.parser.SqlParser;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * {@link SecurityPolicyRewriteRule#markRelationsForRewrite} marks every table a statement reads, at any depth.
+ * The HTTP SQL API and Arrow Flight SQL call it; before they did, a query through either got no column mask
+ * and no row filter.
+ */
+public class SecurityPolicyMarkRelationsTest {
+
+    private static List<TableRelation> tables(StatementBase stmt) {
+        List<TableRelation> out = new ArrayList<>();
+        new AstTraverser<Void, Void>() {
+            @Override
+            public Void visitTable(TableRelation relation, Void context) {
+                out.add(relation);
+                return null;
+            }
+        }.visit(stmt);
+        return out;
+    }
+
+    private static List<TableRelation> markedTables(String sql) {
+        StatementBase stmt = SqlParser.parse(sql, new SessionVariable()).get(0);
+        Assertions.assertTrue(tables(stmt).stream().noneMatch(Relation::isNeedRewrittenByPolicy),
+                "a parsed statement starts unmarked");
+        SecurityPolicyRewriteRule.markRelationsForRewrite(stmt);
+        return tables(stmt);
+    }
+
+    @Test
+    public void marksEveryTableAtAnyDepth() {
+        List<TableRelation> tables = markedTables(
+                "SELECT * FROM a JOIN (SELECT * FROM b WHERE b.x IN (SELECT x FROM c)) s ON a.x = s.x " +
+                        "UNION ALL SELECT * FROM d");
+
+        Assertions.assertEquals(4, tables.size());
+        Assertions.assertTrue(tables.stream().allMatch(Relation::isNeedRewrittenByPolicy));
+    }
+
+    @Test
+    public void marksTheTablesUnderAPivot() {
+        List<TableRelation> tables = markedTables(
+                "SELECT * FROM (SELECT id, region FROM orders) t PIVOT (count(id) FOR region IN ('us', 'eu'))");
+
+        Assertions.assertEquals(1, tables.size());
+        Assertions.assertTrue(tables.get(0).isNeedRewrittenByPolicy());
+    }
+
+    @Test
+    public void marksTheSourceOfAnInsert() {
+        List<TableRelation> tables = markedTables("INSERT INTO target SELECT * FROM source");
+
+        Assertions.assertTrue(tables.stream().anyMatch(t -> t.getName().getTbl().equals("source")));
+        Assertions.assertTrue(tables.stream().allMatch(Relation::isNeedRewrittenByPolicy));
+    }
+}
