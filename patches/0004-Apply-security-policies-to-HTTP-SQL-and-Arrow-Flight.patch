 import java.util.stream.Collectors;
 
 public class SecurityPolicyRewriteRule {
+    /**
+     * Marks every relation of a user statement so the analyzer applies the column masking and row access
+     * policies to it. Every entry point that runs a user's SQL must call this before analysis: a relation
+     * that is not marked is read without any mask or row filter.
+     */
+    public static void markRelationsForRewrite(StatementBase statement) {
+        new AstTraverser<Void, Void>() {
+            @Override
+            public Void visitRelation(Relation relation, Void context) {
+                relation.setNeedRewrittenByPolicy(true);
+                return null;
+            }
+        }.visit(statement);
+    }
+
