+package com.starrocks.authorization;
+
+import com.starrocks.common.ErrorCode;
+import com.starrocks.common.ErrorReportException;
+import com.starrocks.qe.ConnectContext;
+import com.starrocks.sql.analyzer.Analyzer;
+import com.starrocks.sql.analyzer.Authorizer;
+import com.starrocks.sql.ast.StatementBase;
+import com.starrocks.sql.parser.SqlParser;
+import com.starrocks.utframe.StarRocksAssert;
+import com.starrocks.utframe.UtFrameUtils;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.mockito.MockedStatic;
+import org.mockito.Mockito;
+
+/**
+ * Every use of FILES() needs the OPERATE privilege on SYSTEM: it reads and writes object storage with no table
+ * privilege, mask or row filter, and with an instance profile it uses the BE's own cloud identity.
+ */
+public class FilesFunctionPrivilegeTest {
+    private static final String FILES = "FILES('path' = 's3://bucket/data/*', 'format' = 'parquet', " +
+            "'aws.s3.use_instance_profile' = 'true', 'aws.s3.region' = 'us-east-1')";
+    private static ConnectContext connectContext;
+
+    @BeforeAll
+    public static void beforeClass() throws Exception {
+        UtFrameUtils.createMinStarRocksCluster();
+        connectContext = UtFrameUtils.createDefaultCtx();
+        new StarRocksAssert(connectContext).withDatabase("db_files").useDatabase("db_files")
+                .withTable("CREATE TABLE t (id BIGINT) DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1 " +
+                        "PROPERTIES ('replication_num' = '1')");
+    }
+
+    private static Throwable analyze(String sql, boolean hasOperate) {
+        try (MockedStatic<Authorizer> authorizer = Mockito.mockStatic(Authorizer.class, Mockito.CALLS_REAL_METHODS)) {
+            if (!hasOperate) {
+                authorizer.when(() -> Authorizer.checkSystemAction(Mockito.any(), Mockito.eq(PrivilegeType.OPERATE)))
+                        .thenThrow(new AccessDeniedException());
+            }
+            StatementBase stmt = SqlParser.parse(sql, connectContext.getSessionVariable()).get(0);
+            try {
+                Analyzer.analyze(stmt, connectContext);
+                return null;
+            } catch (Throwable t) {
+                return t;
+            }
+        }
+    }
+
+    private static boolean refusedForFiles(Throwable t) {
+        return t instanceof ErrorReportException e
+                && e.getErrorCode() == ErrorCode.ERR_ACCESS_DENIED_FILES_FUNCTION;
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {
+            "SELECT * FROM " + FILES,
+            "INSERT INTO db_files.t SELECT * FROM " + FILES,
+            "INSERT INTO " + FILES + " SELECT * FROM db_files.t",
+            "DESC " + FILES,
+    })
+    public void aUserWithoutOperateIsRefused(String sql) {
+        Throwable t = analyze(sql, false);
+
+        Assertions.assertTrue(refusedForFiles(t), String.valueOf(t));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {
+            "SELECT * FROM " + FILES,
+            "INSERT INTO " + FILES + " SELECT * FROM db_files.t",
+            "DESC " + FILES,
+    })
+    public void aUserWithOperateGetsPastTheCheck(String sql) {
+        // The storage behind the path does not exist, so the statement may still fail, but not on the privilege.
+        Throwable t = analyze(sql, true);
+
+        Assertions.assertFalse(refusedForFiles(t), String.valueOf(t));
+    }
+}
