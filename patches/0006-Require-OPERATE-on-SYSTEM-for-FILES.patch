+package com.starrocks.authorization;
+
+import com.starrocks.common.ErrorCode;
+import com.starrocks.common.ErrorReportException;
+import com.starrocks.qe.ConnectContext;
+import com.starrocks.sql.analyzer.Authorizer;
+
+/**
+ * FILES() reads and writes object storage directly: no table privilege, column mask or row filter applies to
+ * it, and with "aws.s3.use_instance_profile" it uses the BE's own cloud identity, which can reach the data
+ * files of every table. So every use of it (SELECT ... FROM FILES, INSERT INTO FILES, DESC FILES) needs the
+ * OPERATE privilege on SYSTEM.
+ */
+public final class FilesFunctionPrivilege {
+    private FilesFunctionPrivilege() {
+    }
+
+    public static void check(ConnectContext context) {
+        if (context == null || context.getCurrentUserIdentity() == null) {
+            // Internal work with no user session (a pre-split of an insert already checked here).
+            return;
+        }
+        try {
+            Authorizer.checkSystemAction(context, PrivilegeType.OPERATE);
+        } catch (AccessDeniedException e) {
+            throw ErrorReportException.report(ErrorCode.ERR_ACCESS_DENIED_FILES_FUNCTION);
+        }
+    }
+}
