+package com.starrocks.authorization;
+
+import com.starrocks.common.ErrorCode;
+import com.starrocks.common.ErrorReportException;
+import com.starrocks.qe.ConnectContext;
+import com.starrocks.sql.analyzer.Analyzer;
+import com.starrocks.sql.analyzer.Authorizer;
+import com.starrocks.sql.ast.QueryStatement;
+import com.starrocks.sql.ast.StatementBase;
+import com.starrocks.sql.parser.SqlParser;
+import com.starrocks.utframe.StarRocksAssert;
+import com.starrocks.utframe.UtFrameUtils;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.mockito.MockedStatic;
+import org.mockito.Mockito;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * A statement that names a storage location without credentials of the user's own runs with the cluster's
+ * identity, so it needs the OPERATE privilege on SYSTEM.
+ */
+public class ServerStorageIdentityCheckTest {
+    private static final String KEYS = "'aws.s3.access_key' = 'ak', 'aws.s3.secret_key' = 'sk', " +
+            "'aws.s3.region' = 'us-east-1'";
+    private static final String NO_KEYS = "'aws.s3.region' = 'us-east-1'";
+    private static final String PROFILE = KEYS + ", 'aws.s3.use_instance_profile' = 'true'";
+    private static ConnectContext connectContext;
+
+    @BeforeAll
+    public static void beforeClass() throws Exception {
+        UtFrameUtils.createMinStarRocksCluster();
+        connectContext = UtFrameUtils.createDefaultCtx();
+        new StarRocksAssert(connectContext).withDatabase("db_ssi").useDatabase("db_ssi")
+                .withTable("CREATE TABLE t (id BIGINT) DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1 " +
+                        "PROPERTIES ('replication_num' = '1')");
+    }
+
+    // ------------------------------------------------ the rule ------------------------------------------------
+
+    private static boolean server(String path, Map<String, String> props) {
+        return ServerStorageIdentityCheck.usesServerIdentity(List.of(path), props);
+    }
+
+    @Test
+    public void anAccessKeyPairForTheStoreIsTheUsersOwn() {
+        Assertions.assertFalse(server("s3://b/p", Map.of("aws.s3.access_key", "ak", "aws.s3.secret_key", "sk")));
+        Assertions.assertFalse(server("S3A://b/p", Map.of("AWS.S3.ACCESS_KEY", "ak", "aws.s3.secret_key", "sk")));
+        Assertions.assertFalse(server("oss://b/p", Map.of("aliyun.oss.access_key", "ak", "aliyun.oss.secret_key", "sk")));
+        Assertions.assertFalse(server("abfss://c@a.dfs.core.windows.net/p", Map.of("azure.adls2.sas_token", "t")));
+        Assertions.assertFalse(server("gs://b/p", Map.of("gcp.gcs.service_account_private_key", "k",
+                "gcp.gcs.service_account_private_key_id", "i", "gcp.gcs.service_account_email", "e")));
+    }
+
+    @Test
+    public void noKeysFallsBackToTheCluster() {
+        Assertions.assertTrue(server("s3://b/p", Map.of()));
+        Assertions.assertTrue(server("s3://b/p", Map.of("aws.s3.access_key", "ak")));
+        Assertions.assertTrue(server("s3://b/p", Map.of("aws.s3.access_key", "ak", "aws.s3.secret_key", " ")));
+        Assertions.assertTrue(server("s3://b/p", Map.of("aws.s3.iam_role_arn", "arn:aws:iam::1:role/r")));
+        Assertions.assertTrue(ServerStorageIdentityCheck.usesServerIdentity(List.of(), Map.of()));
+        Assertions.assertTrue(ServerStorageIdentityCheck.usesServerIdentity(null, null));
+    }
+
+    @Test
+    public void aClusterIdentitySwitchWinsOverKeys() {
+        for (String flag : List.of("aws.s3.use_instance_profile", "aws.s3.use_aws_sdk_default_behavior",
+                "aws.s3.use_web_identity_token_file")) {
+            Assertions.assertTrue(server("s3://b/p", Map.of("aws.s3.access_key", "ak", "aws.s3.secret_key", "sk",
+                    flag, "TRUE")), flag);
+        }
+        Assertions.assertTrue(server("abfs://c@a.dfs.core.windows.net/p", Map.of("azure.adls2.sas_token", "t",
+                "azure.adls2.oauth2_use_managed_identity", "true")));
+        Assertions.assertTrue(server("s3://b/p", Map.of("aws.s3.access_key", "ak", "aws.s3.secret_key", "sk",
+                "hadoop.kerberos.keytab", "/etc/krb5.keytab")));
+    }
+
+    @Test
+    public void keysForAnotherStoreDoNotCount() {
+        Map<String, String> awsKeys = Map.of("aws.s3.access_key", "ak", "aws.s3.secret_key", "sk");
+        Assertions.assertTrue(server("gs://b/p", awsKeys));
+        Assertions.assertTrue(server("oss://b/p", awsKeys));
+        Assertions.assertTrue(server("hdfs://nn:8020/p", awsKeys));
+        Assertions.assertTrue(server("file:///etc/passwd", awsKeys));
+        Assertions.assertTrue(server("/etc/passwd", awsKeys));
+        Assertions.assertTrue(ServerStorageIdentityCheck.usesServerIdentity(
+                List.of("s3://b/ok", "hdfs://nn/p"), awsKeys));
+    }
+
+    // ------------------------------------------- the statements -----------------------------------------------
+
+    /** Analyzes (when it can) and authorizes `sql`; returns what it threw, or null. */
+    private static Throwable authorize(String sql, boolean hasOperate) {
+        try (MockedStatic<Authorizer> authorizer = Mockito.mockStatic(Authorizer.class, Mockito.CALLS_REAL_METHODS)) {
+            if (!hasOperate) {
+                authorizer.when(() -> Authorizer.checkSystemAction(Mockito.any(), Mockito.eq(PrivilegeType.OPERATE)))
+                        .thenThrow(new AccessDeniedException());
+            }
+            StatementBase stmt = SqlParser.parse(sql, connectContext.getSessionVariable()).get(0);
+            try {
+                Analyzer.analyze(stmt, connectContext);
+            } catch (Throwable t) {
+                if (stmt instanceof QueryStatement) {
+                    // OUTFILE builds its storage properties during analysis.
+                    return t;
+                }
+                // A load, export or file table names its storage in the statement itself; analysis here may
+                // fail on a missing broker or bucket, which the authorization check does not need.
+            }
+            try {
+                Authorizer.check(stmt, connectContext);
+                return null;
+            } catch (Throwable t) {
+                return t;
+            }
+        }
+    }
+
+    private static boolean refused(Throwable t) {
+        return t instanceof ErrorReportException e &&
+                e.getErrorCode() == ErrorCode.ERR_ACCESS_DENIED_SERVER_STORAGE_IDENTITY;
+    }
+
+    private static final String OUTFILE = "SELECT id FROM db_ssi.t INTO OUTFILE 's3://bucket/out/' " +
+            "FORMAT AS CSV PROPERTIES (%s)";
+    private static final String LOAD = "LOAD LABEL db_ssi.l_%s (DATA INFILE('s3://bucket/in/*') INTO TABLE t " +
+            "FORMAT AS 'parquet') WITH BROKER (%s)";
+    private static final String EXPORT = "EXPORT TABLE db_ssi.t TO 's3://bucket/export/' WITH BROKER (%s)";
+    private static final String FILE_TABLE = "CREATE EXTERNAL TABLE db_ssi.ft_%s (id BIGINT) ENGINE = file " +
+            "PROPERTIES ('path' = 's3://bucket/in/', 'format' = 'parquet', %s)";
+
+    private static List<String> statements(String props, String suffix) {
+        return List.of(String.format(OUTFILE, props), String.format(LOAD, suffix, props),
+                String.format(EXPORT, props), String.format(FILE_TABLE, suffix, props));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {NO_KEYS, PROFILE})
+    public void withoutOwnCredentialsAUserWithoutOperateIsRefused(String props) {
+        for (String sql : statements(props, "a")) {
+            Throwable t = authorize(sql, false);
+
+            Assertions.assertTrue(refused(t), sql + " -> " + t);
+        }
+    }
+
+    @Test
+    public void withoutOwnCredentialsAUserWithOperateGetsPastTheCheck() {
+        for (String sql : statements(NO_KEYS, "b")) {
+            Throwable t = authorize(sql, true);
+
+            Assertions.assertFalse(refused(t), sql + " -> " + t);
+        }
+    }
+
+    @Test
+    public void ownCredentialsNeedNoOperate() {
+        for (String sql : statements(KEYS, "c")) {
+            Throwable t = authorize(sql, false);
+
+            Assertions.assertFalse(refused(t), sql + " -> " + t);
+        }
+    }
+}
