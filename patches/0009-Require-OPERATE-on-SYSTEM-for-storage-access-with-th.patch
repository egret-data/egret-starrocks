+package com.starrocks.authorization;
+
+import com.starrocks.common.ErrorCode;
+import com.starrocks.common.ErrorReportException;
+import com.starrocks.qe.ConnectContext;
+import com.starrocks.sql.analyzer.Authorizer;
+
+import java.net.URI;
+import java.util.Collection;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/**
+ * BROKER LOAD, EXPORT, SELECT ... INTO OUTFILE and a FILE external table read or write a storage location the
+ * user names, with storage properties the user writes. When those properties carry no credentials of the user's
+ * own, the FE and BE do not refuse: they fall back to the cluster's identity. An instance profile, the AWS
+ * default credential chain (the legacy S3 client uses it whenever no keys are given), a web identity token, an
+ * Azure managed identity, a GCE service account, a keytab on the server or the keys in be.conf. That identity
+ * usually reaches the data files of every table, so such a statement needs the OPERATE privilege on SYSTEM.
+ *
+ * <p>A statement passes without OPERATE only when every location is on an object store and the properties
+ * name that store's own credentials (an access key pair, a shared key, a SAS token, a client secret, a service
+ * account key) and turn on none of the cluster-identity switches, which take precedence over keys. Anything
+ * else, HDFS and local paths included, is treated as the cluster's identity.
+ */
+public final class ServerStorageIdentityCheck {
+    private ServerStorageIdentityCheck() {
+    }
+
+    /** Switches that make the FE or BE use its own identity, whatever keys are also given. */
+    private static final List<String> SERVER_IDENTITY_SWITCHES = List.of(
+            "aws.s3.use_aws_sdk_default_behavior",
+            "aws.s3.use_instance_profile",
+            "aws.s3.use_web_identity_token_file",
+            "azure.blob.oauth2_use_managed_identity",
+            "azure.adls1.use_managed_service_identity",
+            "azure.adls2.oauth2_use_managed_identity",
+            "gcp.gcs.use_compute_engine_service_account");
+
+    /** Properties that point at a credential file on the server. */
+    private static final List<String> SERVER_CREDENTIAL_FILES = List.of(
+            "azure.adls2.oauth2_token_file",
+            "kerberos_keytab",
+            "hadoop.kerberos.keytab");
+
+    private static final Set<String> S3_SCHEMES = Set.of("s3", "s3a", "s3n", "obs", "ks3", "tos");
+
+    public static void check(ConnectContext context, String statementKind, Collection<String> paths,
+                             Map<String, String> properties) {
+        if (context == null || context.getCurrentUserIdentity() == null) {
+            return;
+        }
+        if (!usesServerIdentity(paths, properties)) {
+            return;
+        }
+        try {
+            Authorizer.checkSystemAction(context, PrivilegeType.OPERATE);
+        } catch (AccessDeniedException e) {
+            throw ErrorReportException.report(ErrorCode.ERR_ACCESS_DENIED_SERVER_STORAGE_IDENTITY, statementKind);
+        }
+    }
+
+    public static boolean usesServerIdentity(Collection<String> paths, Map<String, String> properties) {
+        Map<String, String> props = new TreeMap<>(String.CASE_INSENSITIVE_ORDER);
+        if (properties != null) {
+            props.putAll(properties);
+        }
+        for (String key : SERVER_IDENTITY_SWITCHES) {
+            if (Boolean.parseBoolean(props.getOrDefault(key, "false").trim())) {
+                return true;
+            }
+        }
+        for (String key : SERVER_CREDENTIAL_FILES) {
+            if (present(props, key)) {
+                return true;
+            }
+        }
+        if (paths == null || paths.isEmpty()) {
+            return true;
+        }
+        for (String path : paths) {
+            if (!hasOwnCredentials(scheme(path), props)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasOwnCredentials(String scheme, Map<String, String> props) {
+        if (scheme == null) {
+            return false;
+        }
+        if (S3_SCHEMES.contains(scheme)) {
+            return present(props, "aws.s3.access_key") && present(props, "aws.s3.secret_key");
+        }
+        switch (scheme) {
+            case "oss":
+                return present(props, "aliyun.oss.access_key") && present(props, "aliyun.oss.secret_key");
+            case "cos":
+            case "cosn":
+                return present(props, "tencent.cos.access_key") && present(props, "tencent.cos.secret_key");
+            case "gs":
+                return present(props, "gcp.gcs.service_account_private_key") &&
+                        present(props, "gcp.gcs.service_account_private_key_id") &&
+                        present(props, "gcp.gcs.service_account_email");
+            case "wasb":
+            case "wasbs":
+                return present(props, "azure.blob.shared_key") || present(props, "azure.blob.sas_token") ||
+                        present(props, "azure.blob.oauth2_client_secret");
+            case "abfs":
+            case "abfss":
+                return present(props, "azure.adls2.shared_key") || present(props, "azure.adls2.sas_token") ||
+                        present(props, "azure.adls2.oauth2_client_secret");
+            case "adl":
+                return present(props, "azure.adls1.oauth2_credential");
+            default:
+                // hdfs://, viewfs://, file:// and anything else: the cluster's own access.
+                return false;
+        }
+    }
+
+    private static boolean present(Map<String, String> props, String key) {
+        String value = props.get(key);
+        return value != null && !value.trim().isEmpty();
+    }
+
+    private static String scheme(String path) {
+        if (path == null) {
+            return null;
+        }
+        try {
+            String scheme = new URI(path.trim()).getScheme();
+            return scheme == null ? null : scheme.toLowerCase(Locale.ROOT);
+        } catch (Exception e) {
+            int colon = path.indexOf("://");
+            return colon > 0 ? path.substring(0, colon).trim().toLowerCase(Locale.ROOT) : null;
+        }
+    }
+}
